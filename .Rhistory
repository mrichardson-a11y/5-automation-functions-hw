library(tidyverse)
set.seed(1)
id <- rep("name", 30)
x <- runif(30, 0, 10)
y <- runif(30, 0, 10)
z <- runif(30, 0, 10)
ds <- tibble(id, x, y, z)
limit_replace <- function(x) str_replace_all(8>, 2<, "NA")
limit_replace <- function(x) str_replace_all(8> 2<, "NA")
limit_replace <- function(limit_replace) {
ifelse(MR > 8 | MR < 2, NA, MR )
return
}
limit_replace(x)
limit_replace <- function(MR) {
ifelse(MR > 8 | MR < 2, NA, MR )
return
}
limit_replace(x)
